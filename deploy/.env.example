# Copy to deploy/.env and fill in. Never commit the real file: it is in .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=dms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dms
POSTGRES_PORT=5433
# The Docker daemon on this machine cannot reach mcr/docker.io; override with a locally
# available image when needed, for example timescale/timescaledb-ha:pg16.
#POSTGRES_IMAGE=postgres:18

# Backend DB host inside compose. Default is the service name (postgres:5432). If containers
# cannot reach each other on the bridge (nested Docker), either use compose.nested.yml or set:
#DMS_DB_HOST=host.docker.internal
#DMS_DB_PORT=5433

# The role the API and the worker connect as. The migrator creates it and grants it DML only;
# it can never change or remove audit rows (section 4.10). Generate with: openssl rand -base64 32
DMS_DB_APP_PASSWORD=

# Ubuntu packages inside the API image (tesseract, poppler). Leave empty to try HTTPS
# archive.ubuntu.com, then mirror.arvancloud.ir, then mirrors.edge.kernel.org.
# If `apt-get update` still fails, pin one mirror that answers from your network:
#APT_MIRROR=https://mirror.arvancloud.ir/ubuntu

# --- API ---
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 bytes. Generate with: openssl rand -base64 64
DMS_JWT_SIGNING_KEY=
# Scanner web app (the Expo export behind nginx). Same origin as its own /api proxy.
SCANNER_PORT=8091

# Browser origin for CORS when the SPA is not same-origin with the API (Vite: http://localhost:5173).
# Production behind the compose web/nginx service is same-origin — set the public HTTPS origin
# (e.g. https://archive.example.com) or leave empty. Never use '*'. See deploy/nginx/tls.conf.example.
DMS_FRONTEND_ORIGIN=http://localhost:5173

# Seals the audit log (HMAC-SHA256), so rewriting it needs this key as well as the database.
# Keep it outside the database backups. Generate with: openssl rand -base64 32
# After a rotation, keep the old key in Dms__Audit__PreviousSealKeys__0 so older seals still verify.
DMS_AUDIT_SEAL_KEY=

# --- First administrator (created once, must change the password at first sign-in) ---
DMS_ADMIN_USERNAME=admin
DMS_ADMIN_PASSWORD=

# --- Processing (phase 5) ---
# OCR: the backend image includes tesseract-ocr-fas/eng + poppler. Local OCR runs when
# DMS_TIKA_URL is empty (default). Set DMS_TIKA_URL to prefer Tika Server instead.
#Dms__Search__Tesseract__Enabled=true
# Which optional services to start: search (OpenSearch + Tika), scan (ClamAV), office (Gotenberg).
# Without the search profile (and DMS_OPENSEARCH_URL), the admin UI shows موتور جستجو = غیرفعال;
# title/description/filename search still works via Postgres. Local Tesseract OCR can stay on.
#COMPOSE_PROFILES=search,scan,office
# Point the backend at them. Leave empty for any profile that is not enabled.
#DMS_OPENSEARCH_URL=http://opensearch:9200
# Optional: prefer Tika Server for OCR instead of local tesseract on the worker image.
#DMS_TIKA_URL=http://tika:9998
#DMS_GOTENBERG_URL=http://gotenberg:3000
# With scanning on, files stay unavailable until ClamAV reports them clean (decision D9).
#DMS_SCAN_ENABLED=true
