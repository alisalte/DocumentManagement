# Copy to deploy/.env and fill in. Never commit the real file: it is in .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=dms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dms
POSTGRES_PORT=5433
# The Docker daemon on this machine cannot reach mcr/docker.io; override with a locally
# available image when needed, for example timescale/timescaledb-ha:pg16.
#POSTGRES_IMAGE=postgres:18

# --- API ---
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 bytes. Generate with: openssl rand -base64 64
DMS_JWT_SIGNING_KEY=
# api | worker | all
DMS_ROLE=all
DMS_FRONTEND_ORIGIN=http://localhost:5173

# --- First administrator (created once, must change the password at first sign-in) ---
DMS_ADMIN_USERNAME=admin
DMS_ADMIN_PASSWORD=
