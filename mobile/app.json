{
  "expo": {
    "name": "اسکنر اسناد",
    "slug": "dms-scanner",
    "scheme": "dms-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dms.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "برای اسکن برگه‌های سند به دوربین نیاز است.",
        "NSPhotoLibraryUsageDescription": "برای افزودن تصویر سند از گالری به دسترسی عکس‌ها نیاز است."
      }
    },
    "android": {
      "package": "com.dms.scanner",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#6C4EFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "برای اسکن برگه‌های سند به دوربین نیاز است.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای افزودن تصویر سند از گالری به دسترسی عکس‌ها نیاز است.",
          "cameraPermission": "برای اسکن برگه‌های سند به دوربین نیاز است.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Vazirmatn-Regular.ttf",
            "./assets/fonts/Vazirmatn-Medium.ttf",
            "./assets/fonts/Vazirmatn-SemiBold.ttf",
            "./assets/fonts/Vazirmatn-Bold.ttf",
            "./assets/fonts/Vazirmatn-ExtraBold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Vazir",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Vazirmatn-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Vazirmatn-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Vazirmatn-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Vazirmatn-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Vazirmatn-ExtraBold.ttf", "weight": 800 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportsRTL": true
    }
  }
}
