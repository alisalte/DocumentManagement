{
  "expo": {
    "name": "اسکنر اسناد",
    "slug": "dms-scanner",
    "scheme": "dms-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dms.scanner",
      "infoPlist": {
        "NSCameraUsageDescription": "برای اسکن برگه‌های سند به دوربین نیاز است.",
        "NSPhotoLibraryUsageDescription": "برای افزودن تصویر سند از گالری به دسترسی عکس‌ها نیاز است."
      }
    },
    "android": {
      "package": "com.dms.scanner",
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#1F4D3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "برای اسکن برگه‌های سند به دوربین نیاز است.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای افزودن تصویر سند از گالری به دسترسی عکس‌ها نیاز است.",
          "cameraPermission": "برای اسکن برگه‌های سند به دوربین نیاز است.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportsRTL": true
    }
  }
}
