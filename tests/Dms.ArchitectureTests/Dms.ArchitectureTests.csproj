<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Dms.ArchitectureTests</RootNamespace>
    <!-- xUnit1051 wants an explicit CancellationToken on every awaited call; the tests are
         short lived and run against a throwaway database, so the noise is not worth it. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dms.Host\Dms.Host.csproj" />
    <ProjectReference Include="..\..\src\Modules\Audit\Dms.Audit\Dms.Audit.csproj" />
    <ProjectReference Include="..\..\src\Modules\Authorization\Dms.Authorization\Dms.Authorization.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Dms.Identity\Dms.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\Documents\Dms.Documents\Dms.Documents.csproj" />
    <ProjectReference Include="..\..\src\Modules\DocumentTypes\Dms.DocumentTypes\Dms.DocumentTypes.csproj" />
    <ProjectReference Include="..\..\src\Modules\Storage\Dms.Storage\Dms.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
