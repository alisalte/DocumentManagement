{
  "$comment": "Shared by tests/Dms.DocumentTypes.UnitTests (C#) and frontend/src/lib/rules.test.ts (TypeScript). Both evaluators must give the same answer for every case; add a case here whenever the semantics are clarified.",
  "evaluate": [
    { "name": "eq number", "rule": { "field": "amount", "op": "eq", "value": 10 }, "data": { "amount": 10 }, "expected": true },
    { "name": "eq number with decimals", "rule": { "field": "amount", "op": "eq", "value": 10 }, "data": { "amount": 10.0 }, "expected": true },
    { "name": "eq string", "rule": { "field": "status", "op": "eq", "value": "open" }, "data": { "status": "open" }, "expected": true },
    { "name": "eq is case sensitive", "rule": { "field": "status", "op": "eq", "value": "open" }, "data": { "status": "Open" }, "expected": false },
    { "name": "eq different kinds", "rule": { "field": "amount", "op": "eq", "value": "10" }, "data": { "amount": 10 }, "expected": false },
    { "name": "eq boolean", "rule": { "field": "urgent", "op": "eq", "value": true }, "data": { "urgent": true }, "expected": true },
    { "name": "eq null matches missing", "rule": { "field": "x", "op": "eq", "value": null }, "data": {}, "expected": true },
    { "name": "eq missing field", "rule": { "field": "amount", "op": "eq", "value": 10 }, "data": {}, "expected": false },
    { "name": "ne missing field", "rule": { "field": "amount", "op": "ne", "value": 10 }, "data": {}, "expected": true },
    { "name": "ne different", "rule": { "field": "status", "op": "ne", "value": "open" }, "data": { "status": "closed" }, "expected": true },
    { "name": "gt large amount", "rule": { "field": "amount", "op": "gt", "value": 10000000000 }, "data": { "amount": 12000000000 }, "expected": true },
    { "name": "gt equal is false", "rule": { "field": "amount", "op": "gt", "value": 10000000000 }, "data": { "amount": 10000000000 }, "expected": false },
    { "name": "gte equal", "rule": { "field": "amount", "op": "gte", "value": 5 }, "data": { "amount": 5 }, "expected": true },
    { "name": "lt", "rule": { "field": "amount", "op": "lt", "value": 5 }, "data": { "amount": 4.5 }, "expected": true },
    { "name": "lte", "rule": { "field": "amount", "op": "lte", "value": 5 }, "data": { "amount": 6 }, "expected": false },
    { "name": "gt on missing is false", "rule": { "field": "amount", "op": "gt", "value": 0 }, "data": {}, "expected": false },
    { "name": "gt on string vs number is false", "rule": { "field": "amount", "op": "gt", "value": 0 }, "data": { "amount": "5" }, "expected": false },
    { "name": "date after", "rule": { "field": "signed_on", "op": "gt", "value": "2024-03-20" }, "data": { "signed_on": "2024-12-01" }, "expected": true },
    { "name": "date before", "rule": { "field": "signed_on", "op": "lt", "value": "2024-03-20" }, "data": { "signed_on": "2023-12-31" }, "expected": true },
    { "name": "in", "rule": { "field": "status", "op": "in", "value": ["open", "pending"] }, "data": { "status": "pending" }, "expected": true },
    { "name": "in missing", "rule": { "field": "status", "op": "in", "value": ["open"] }, "data": {}, "expected": false },
    { "name": "not_in", "rule": { "field": "status", "op": "not_in", "value": ["void"] }, "data": { "status": "open" }, "expected": true },
    { "name": "not_in missing", "rule": { "field": "status", "op": "not_in", "value": ["void"] }, "data": {}, "expected": true },
    { "name": "in numbers", "rule": { "field": "level", "op": "in", "value": [1, 2, 3] }, "data": { "level": 2 }, "expected": true },
    { "name": "multi select eq any element", "rule": { "field": "regions", "op": "eq", "value": "north" }, "data": { "regions": ["south", "north"] }, "expected": true },
    { "name": "multi select in", "rule": { "field": "regions", "op": "in", "value": ["east", "north"] }, "data": { "regions": ["south", "north"] }, "expected": true },
    { "name": "multi select contains", "rule": { "field": "regions", "op": "contains", "value": "south" }, "data": { "regions": ["south"] }, "expected": true },
    { "name": "multi select contains missing", "rule": { "field": "regions", "op": "contains", "value": "west" }, "data": { "regions": ["south"] }, "expected": false },
    { "name": "text contains ignores case", "rule": { "field": "title", "op": "contains", "value": "ABC" }, "data": { "title": "Contract with abc Ltd" }, "expected": true },
    { "name": "text contains persian", "rule": { "field": "title", "op": "contains", "value": "قرارداد" }, "data": { "title": "متن قرارداد نهایی" }, "expected": true },
    { "name": "is_empty missing", "rule": { "field": "note", "op": "is_empty" }, "data": {}, "expected": true },
    { "name": "is_empty null", "rule": { "field": "note", "op": "is_empty" }, "data": { "note": null }, "expected": true },
    { "name": "is_empty whitespace", "rule": { "field": "note", "op": "is_empty" }, "data": { "note": "   " }, "expected": true },
    { "name": "is_empty empty list", "rule": { "field": "regions", "op": "is_empty" }, "data": { "regions": [] }, "expected": true },
    { "name": "is_empty zero is not empty", "rule": { "field": "amount", "op": "is_empty" }, "data": { "amount": 0 }, "expected": false },
    { "name": "is_empty false is not empty", "rule": { "field": "urgent", "op": "is_empty" }, "data": { "urgent": false }, "expected": false },
    { "name": "all true", "rule": { "all": [ { "field": "a", "op": "eq", "value": 1 }, { "field": "b", "op": "eq", "value": 2 } ] }, "data": { "a": 1, "b": 2 }, "expected": true },
    { "name": "all one false", "rule": { "all": [ { "field": "a", "op": "eq", "value": 1 }, { "field": "b", "op": "eq", "value": 3 } ] }, "data": { "a": 1, "b": 2 }, "expected": false },
    { "name": "any one true", "rule": { "any": [ { "field": "a", "op": "eq", "value": 9 }, { "field": "b", "op": "eq", "value": 2 } ] }, "data": { "a": 1, "b": 2 }, "expected": true },
    { "name": "not", "rule": { "not": { "field": "a", "op": "eq", "value": 1 } }, "data": { "a": 2 }, "expected": true },
    { "name": "nested", "rule": { "all": [ { "field": "type", "op": "eq", "value": "contract" }, { "any": [ { "field": "amount", "op": "gt", "value": 1000 }, { "not": { "field": "vendor", "op": "is_empty" } } ] } ] }, "data": { "type": "contract", "amount": 10, "vendor": "ACME" }, "expected": true }
  ],
  "invalid": [
    { "name": "not an object", "rule": [1, 2] },
    { "name": "unknown operator", "rule": { "field": "a", "op": "like", "value": "x" } },
    { "name": "bad field code", "rule": { "field": "Amount-1", "op": "eq", "value": 1 } },
    { "name": "missing value", "rule": { "field": "a", "op": "eq" } },
    { "name": "is_empty with value", "rule": { "field": "a", "op": "is_empty", "value": 1 } },
    { "name": "in without list", "rule": { "field": "a", "op": "in", "value": 1 } },
    { "name": "gt with boolean", "rule": { "field": "a", "op": "gt", "value": true } },
    { "name": "eq with object", "rule": { "field": "a", "op": "eq", "value": { "x": 1 } } },
    { "name": "empty all", "rule": { "all": [] } },
    { "name": "extra key", "rule": { "field": "a", "op": "eq", "value": 1, "code": "x" } },
    { "name": "mixed combinators", "rule": { "all": [ { "field": "a", "op": "eq", "value": 1 } ], "any": [ { "field": "a", "op": "eq", "value": 1 } ] } },
    { "name": "too deep", "rule": { "not": { "not": { "not": { "not": { "not": { "not": { "not": { "not": { "field": "a", "op": "is_empty" } } } } } } } } } }
  ]
}
